# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your private key.

# Your wallet private key (without 0x prefix is fine)
# This wallet pays the deployment gas fee.
PRIVATE_KEY=your_private_key_here

# RPC URL for your chosen network.
# Free options: Alchemy (alchemy.com) or Infura (infura.io)
# Example Sepolia: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://rpc.sepolia.org

# Treasury wallet — receives the 3% fee on every transfer.
# Leave blank to use the deployer wallet as treasury.
TREASURY_ADDRESS=

# Block explorer API keys (needed for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
